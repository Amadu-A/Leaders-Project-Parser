# .env.example
# Безопасный каталог defaults. Реальные пароли задаются только в приватном .env.
APP_BIND_IP=127.0.0.1
APP_PORT=8089
POSTGRES_HOST=leaders-parser-postgres
POSTGRES_DB=leaders_parser
POSTGRES_USER=leaders_parser
POSTGRES_PASSWORD=
# Необязательный override для локального запуска; пароль URL-кодируется.
DATABASE_URL=
SOURCE_URL=https://leaders-project.ru/companies/projecting?size=100
# auto/http: разрешённый публичный JSON API; browser: диагностика HTML/JavaScript.
SOURCE_MODE=auto
# Владелец разрешил пользователю публичный автоматический сбор (13.11.2026).
# false запрещает также необходимые браузеру /api/* согласно robots.txt.
SOURCE_API_ACCESS_APPROVED=true
USER_AGENT="LeadersProjectParser/0.1 (+public company catalogue)"
REQUEST_MIN_DELAY=7
REQUEST_MAX_DELAY=12
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_POOL_TIMEOUT=10
HTTP_TOTAL_TIMEOUT=45
MAX_RETRIES=3
MAX_CONCURRENCY=1
RATE_LIMIT_COOLDOWN=1800
STATUS_POLL_INTERVAL=5
# Первый JS-bootstrap также загружает ресурсы последовательно с общим limiter.
BROWSER_RENDER_TIMEOUT=1800
RETENTION_DAYS=7
LOG_LEVEL=INFO
